{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "short_name": "PhishShield",
  "version": "1.4.1",
  "description": "__MSG_extDescription__",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bing.com/*",
        "https://cn.bing.com/*",
        "https://bing.com/*",
        "https://www.baidu.com/*",
        "https://www.sogou.com/*",
        "https://www.so.com/*",
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.com.hk/*",
        "https://duckduckgo.com/*"
      ],
      "css": ["content.css"],
      "js": [
        "common/blacklist.js",
        "common/brands.js",
        "common/heuristics.js",
        "common/i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}